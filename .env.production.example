# SmartMart Analytics - Production Environment Configuration Template
# Copy this file to .env on your production server or configure these in your Cloud Dashboard.

# Application Secret Key (Generate a random 32-character string: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-very-long-and-cryptographically-secure-random-token

# Environment Mode
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cookie Security (set to 1 if serving over HTTPS / SSL)
SESSION_COOKIE_SECURE=1

# Option A: Standard Database Connection URL (Recommended for Render, Railway, AWS RDS, Cloud SQL)
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/smartmart_dw?charset=utf8mb4

# Option B: Explicit MySQL Credentials (Used if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=smartmart_admin
DB_PASSWORD=your_strong_mysql_password
DB_NAME=smartmart_dw
